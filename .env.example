# Environment
APP_NAME=Nexus One
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./nexus_one.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API
API_V1_PREFIX=/api/v1

# CORS - comma-separated list of allowed origins
# Development defaults:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# Detection
SEED_RULES=false

# Future: PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexus_one

# Machine learning
# ML_MODEL_PATH=./models

# AI investigation layer (LLM provider)
# Provider selection: leave unset to auto-detect (OpenAI-compatible when
# LLM_API_KEY is present, otherwise unconfigured), "openai" for an explicit
# OpenAI-compatible provider, or "demo" for the deterministic offline
# DEMO/MOCK provider used in local development and demos.
# LLM_PROVIDER=openai
# LLM_API_KEY=your-llm-api-key
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_CONTEXT_CHARS=100000
# LLM_MAX_ALERTS_IN_CONTEXT=50
