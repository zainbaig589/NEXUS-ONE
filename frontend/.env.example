# Backend API base URL used by the frontend (no trailing slash).
# Leave empty in development to use the Vite dev-server proxy (see vite.config.ts).
# Example:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Target used by the Vite dev-server proxy when VITE_API_BASE_URL is empty.
VITE_PROXY_TARGET=http://127.0.0.1:8000
